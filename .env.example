# Configurações do Banco de Dados
# Porta externa para acessar via DBeaver (5433 evita conflito com Postgres local na 5432)
POSTGRES_PORT=5433

# Quando rodando localmente (fora do Docker) conectando no Postgres do Docker:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/b3_swing_trade

# Quando rodando via docker-compose (o compose já injeta isso automaticamente):
# DATABASE_URL=postgresql://postgres:postgres@db:5432/b3_swing_trade

# Se deixado em branco, a aplicação usa SQLite local (b3_swing_trade.db) como fallback seguro
DATABASE_URL=

# Configurações do Streamlit
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
